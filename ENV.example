# ============================================================================
# MAIN APPLICATION BACKEND (Express Server)
# ============================================================================
# Port configuration - changed to 3001 to avoid conflicts with common services
PORT=3001
HOST=0.0.0.0
# If PORT is busy, try next ports automatically (dev-friendly)
PORT_FALLBACK=true
# How many ports to try starting from PORT
PORT_MAX_ATTEMPTS=10

# CORS - Allow frontend origins (comma-separated)
# Development: localhost origins
# Production: your hosting domain + VPS IP if needed
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Authentication
AUTH_JWT_SECRET=change-me-long-random-string
AUTH_JWT_EXPIRES_IN=7d

# Telemetry
TELEMETRY_SALT=change-me-too

# Database path (defaults to server/var/app.sqlite)
# DB_PATH=/absolute/path/to/app.sqlite

# ============================================================================
# FRONTEND (Vite)
# ============================================================================
# API URL configuration
# Development: localhost backend
# Production: VPS IPv4 address (e.g., http://123.45.67.89:3001/api)
# VITE_API_URL=http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api
VITE_API_TIMEOUT=10000
VITE_PRINT_API_URL=http://localhost:3100/api/v1

# ============================================================================
# PRINT SERVICE (Separate microservice)
# ============================================================================
# See print-service/server/.env.example for print service configuration
# Print service runs on port 3100 by default
